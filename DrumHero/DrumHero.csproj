<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- <ApplicationIcon>Resources\drumhero.ico</ApplicationIcon> -->
    <AssemblyName>DrumHero</AssemblyName>
    <RootNamespace>DrumHero</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Lucas</Authors>
    <Description>Drum Hero - Guitar Hero-style drum training application for electronic drum kits</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Audio playback and MIDI -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />
    
    <!-- Time-stretching (pure C# SoundTouch port) -->
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport" Version="2.3.1" />
    
    <!-- FLAC metadata reading -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    
    <!-- SQLite persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    
    <!-- Dependency injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    
    <!-- JSON serialization -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    
    <!-- Community MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
