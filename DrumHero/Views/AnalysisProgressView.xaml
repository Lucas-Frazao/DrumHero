<UserControl x:Class="DrumHero.Views.AnalysisProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrumHero.ViewModels"
             d:DataContext="{d:DesignInstance vm:AnalysisProgressViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             Background="#1A1A2E">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
        <Border Background="#16213E" CornerRadius="12" Padding="40">
            <StackPanel>
                <TextBlock Text="Analyzing Song" Foreground="White" FontSize="24"
                           FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SongTitle}" Foreground="#B0B0B0" FontSize="14"
                           FontFamily="Segoe UI" Margin="0,0,0,20"/>

                <!-- Progress bar -->
                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                             Height="8" Foreground="#0F3460" Background="#2A2A4A"
                             BorderThickness="0" Margin="0,0,0,15"/>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="#808090" FontSize="13"
                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Stage indicator -->
                <TextBlock Text="{Binding CurrentStage}" Foreground="#505070" FontSize="11"
                           FontFamily="Segoe UI" Margin="0,0,0,20"/>

                <!-- Error display -->
                <Border Background="#3A1A1A" CornerRadius="6" Padding="15" Margin="0,0,0,15"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E94560"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Padding="20,8" Margin="0,0,10,0"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding CanCancel}"
                            Background="#3A2A2A" Foreground="White" BorderThickness="0"
                            FontFamily="Segoe UI" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Back to Library" Padding="20,8"
                            Command="{Binding GoBackCommand}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                            Background="#0F3460" Foreground="White" BorderThickness="0"
                            FontFamily="Segoe UI" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
