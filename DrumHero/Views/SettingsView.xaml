<UserControl x:Class="DrumHero.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrumHero.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
        d:DesignWidth="600"
             Background="#1A1A2E">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
            Margin="30">
        <StackPanel MaxWidth="500">
            <!-- Header -->
            <DockPanel Margin="0,0,0,25">
                <Button Content="← Back"
                        DockPanel.Dock="Left"
                        Padding="12,6"
                        Command="{Binding GoBackCommand}"
                        Background="#2A2A4A"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Settings"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"
                           FontFamily="Segoe UI"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0"/>
            </DockPanel>

            <!-- Audio Output -->
            <TextBlock Text="AUDIO OUTPUT"
                    Foreground="#808090"
                    FontSize="11"
                    FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                    Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding AudioOutputDevices}"
                      SelectedItem="{Binding SelectedAudioDevice}"
                      DisplayMemberPath="Name"
                    Margin="0,0,0,20"
                      Background="#16213E"
                    Foreground="White"
                    FontFamily="Segoe UI"/>

            <!-- MIDI Input -->
            <DockPanel Margin="0,0,0,8">
                <Button Content="↻ Refresh"
                        DockPanel.Dock="Right"
                        Padding="8,4"
                        Command="{Binding RefreshDevicesCommand}"
                        Background="#2A2A4A"
                        Foreground="#B0B0B0"
                        BorderThickness="0"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="MIDI INPUT DEVICE"
                        Foreground="#808090"
                        FontSize="11"
                           FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        VerticalAlignment="Center"/>
            </DockPanel>
            <ComboBox ItemsSource="{Binding MidiInputDevices}"
                      SelectedItem="{Binding SelectedMidiDevice}"
                      DisplayMemberPath="Name"
                    Margin="0,0,0,20"
                      Background="#16213E"
                    Foreground="White"
                    FontFamily="Segoe UI"/>

            <!-- Difficulty -->
            <TextBlock Text="DIFFICULTY"
                    Foreground="#808090"
                    FontSize="11"
                    FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                    Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding DifficultyLevels}"
                      SelectedItem="{Binding Difficulty}"
                    Margin="0,0,0,4"
                      Background="#16213E"
                    Foreground="White"
                    FontFamily="Segoe UI"/>
            <TextBlock Text="{Binding DifficultyDescription}"
                    Foreground="#606080"
                    FontSize="11"
                       FontFamily="Segoe UI"
                    Margin="0,0,0,20"/>

            <!-- Audio Buffer -->
            <TextBlock Text="AUDIO BUFFER SIZE (MS)"
                    Foreground="#808090"
                    FontSize="11"
                       FontWeight="SemiBold"
                    FontFamily="Segoe UI"
                    Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,4">
                <Slider Value="{Binding AudioBufferSizeMs}"
                        Minimum="10"
                        Maximum="200"
                        Width="300"
                        VerticalAlignment="Center"
                        Foreground="#0F3460"/>
                <TextBlock Text="{Binding AudioBufferSizeMs, StringFormat='{}{0} ms'}"
                           Foreground="White"
                        FontFamily="Segoe UI"
                        Margin="15,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Lower = less latency but more CPU. 50ms recommended."
                       Foreground="#606080"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Margin="0,0,0,20"/>

            <!-- Input timing calibration -->
            <TextBlock Text="HIT TIMING OFFSET (MS)"
                    Foreground="#808090"
                    FontSize="11"
                       FontWeight="SemiBold"
                    FontFamily="Segoe UI"
                    Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,4">
                <Slider Value="{Binding InputTimingOffsetMs}"
                        Minimum="0"
                        Maximum="150"
                        Width="300"
                        VerticalAlignment="Center"
                        Foreground="#0F3460"/>
                <TextBlock Text="{Binding InputTimingOffsetMs, StringFormat='{}{0} ms'}"
                           Foreground="White"
                        FontFamily="Segoe UI"
                        Margin="15,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Increase if your hits register late. Start around 45ms."
                       Foreground="#606080"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Margin="0,0,0,20"/>

            <!-- Count-in -->
            <TextBlock Text="COUNT-IN BARS"
                    Foreground="#808090"
                    FontSize="11"
                    FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                    Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,20">
                <RadioButton Content="None"
                        Foreground="White"
                        FontFamily="Segoe UI"
                        Margin="0,0,15,0"
                             IsChecked="{Binding CountInBars, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"/>
                <RadioButton Content="1 Bar"
                        Foreground="White"
                        FontFamily="Segoe UI"
                        Margin="0,0,15,0"
                             IsChecked="{Binding CountInBars, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"/>
                <RadioButton Content="2 Bars"
                        Foreground="White"
                        FontFamily="Segoe UI"
                             IsChecked="{Binding CountInBars, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"/>
            </StackPanel>

            <!-- Save button -->
            <Button Content="Save Settings"
                    Padding="20,10"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveCommand}"
                    Background="#0F3460"
                    Foreground="White"
                    BorderThickness="0"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    Cursor="Hand"
                    Margin="0,10,0,10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Text="{Binding StatusMessage}"
                    Foreground="#00E676"
                    FontSize="12"
                       FontFamily="Segoe UI"
                    Margin="0,5,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
